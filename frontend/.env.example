# ─── Frontend Environment Variables ──────────────────────────────────────────
# Copy this file to .env (for local dev) or .env.production (for prod build).
# Vite bakes these values into the bundle at BUILD TIME — set them before
# running `npm run build`.

# The full public URL of the deployed Flask backend.
# Leave blank in local dev — the Vite proxy handles /api/* requests automatically.
# Example: VITE_API_BASE_URL=https://your-data-vista-api.onrender.com
VITE_API_BASE_URL=
