# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in the values before starting the server.

# Database connection URL.
# Leave blank to use the default local SQLite database (careercompass.db).
# For production use a PostgreSQL URL, e.g.:
#   postgresql://user:password@host:5432/datavista
DATABASE_URL=

# A long, random, unpredictable string used to sign Flask sessions.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "true" only during local development. Must be "false" in production.
FLASK_DEBUG=false

# The port the Flask app listens on (default: 5000).
PORT=5000
